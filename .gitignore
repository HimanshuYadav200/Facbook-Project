# --- Secrets: never commit ---
.env
**/.env
!**/.env.example

# --- Python / Node environments (re-created from requirements.txt / package-lock.json) ---
.venv/
**/.venv/
__pycache__/
*.pyc
node_modules/
**/node_modules/

# --- Caches and databases ---
*.db
engine/cache/

# --- Media: too big for git, re-generated or backed up separately ---
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.gif
# owned character art is vector (SVG) and IS committed

# --- Render / run outputs ---
runs/*/out/
runs/*/incoming/
runs/*/review/*.jpg
engine/remotion/public/run

# --- Legacy project: code only, never its media folders ---
YouTubeAutomation/output/
YouTubeAutomation/assets/
YouTubeAutomation/reference_reels/

# --- OS / editor junk ---
.DS_Store
.vscode/
.idea/
