# --- Secrets: never commit ---
.env
**/.env
!**/.env.example

# --- Python / Node environments (re-created from requirements.txt / package-lock.json) ---
.venv/
**/.venv/
__pycache__/
*.pyc
node_modules/
**/node_modules/

# --- Caches and databases ---
*.db
engine/cache/

# --- Media: too big for git, re-generated or backed up separately ---
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.gif
# owned character art is vector (SVG) and IS committed

# --- Render / run outputs ---
runs/*/*/out/
runs/*/*/incoming/
runs/*/*/review/*.jpg
engine/remotion/.stage/

# --- OS / editor junk ---
.DS_Store
.vscode/
.idea/
runs/*/*/blender_test/frames_*/
runs/*/*/blender_test/*.mp4

# sfx.json backups made by gen_sfx.py / imports (local safety copies)
library/sfx.json.bak-*
# facts.json backups made by fact_check.py --apply / hand edits
runs/*/*/facts.json.bak-*
